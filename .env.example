# URL y clave publicable del proyecto. No uses aquí service_role ni secretos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Opcional. URL pública del despliegue para redirecciones de autenticación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor. Nunca uses estas variables con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_SOLO_EN_LOCAL
GOOGLE_CLIENT_ID=REEMPLAZAR.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REEMPLAZAR_SOLO_EN_LOCAL
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# 32 bytes aleatorios codificados en base64.
GOOGLE_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_SOLO_EN_LOCAL
